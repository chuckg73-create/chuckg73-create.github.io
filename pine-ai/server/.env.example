# Copy to .env and fill in. NEVER commit .env.

# --- Anthropic (the brain) ---
ANTHROPIC_API_KEY=sk-ant-...
CEDAR_MODEL=claude-sonnet-5

# --- Twilio (places the calls) ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+15551234567     # a Twilio number you own

# --- Public URL of THIS server ---
# Twilio needs to reach your server over the public internet. In dev, run
# `ngrok http 3000` and paste the https URL here (no trailing slash).
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# --- Voice (speech-to-text / text-to-speech) ---
# Options: use Twilio's built-in <Gather>/<Say> (simplest, configured in code),
# or plug in Deepgram (STT) + ElevenLabs (TTS) via a media stream for a natural
# real-time voice. Keys below are only needed for the media-stream path.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

PORT=3000
