// KindredTable — secrets template
//
// 1. Copy this file to `Secrets.xcconfig` (which is gitignored).
// 2. Paste your Google Gemini API key below.
// 3. In Xcode: Project ▸ Info ▸ Configurations, set both Debug and Release to
//    use `Secrets.xcconfig` as the base configuration (or add it via
//    `#include "Secrets.xcconfig"` from your own project config).
//
// The key flows: Secrets.xcconfig → GEMINI_API_KEY build setting →
// INFOPLIST_KEY_GEMINI_API_KEY → Info.plist → AppConfig.geminiAPIKey.
//
// Without a key the app runs in offline "sample" mode.

GEMINI_API_KEY = your-gemini-api-key-here
